      "parameters": {
        "jsCode": "const data = $('Telegram Trigger').first().json.message\nlet prompt = '';\n\nif (data.text) {\n  prompt = \"type:text, question: \"+data.text;\n} else if (data?.photo && data?.caption) {\n  prompt = \"type:photo & caption, question: catat pengeluaran: \" + data.caption;\n} else if (data?.photo) {\n  prompt = 'type:photo only, question: Analisa foto tersebut & catat ke jurnal keuangan';\n}\n\nreturn [\n  {\n    json: {\n      prompt\n    }\n  }\n];\n"
      },
