      "typeVersion": 4,
      "position": [470, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const records = $input.all().map(i => i.json);\nconst currentWeek = new Date().toISOString().slice(0, 10);\nconst notSubmitted = records.filter(r => {\n  return r.weekEnding === currentWeek && (!r.submitted || r.submitted === 'no');\n});\nreturn notSubmitted.map(r => ({ json: r }));"
      },
      "name": "Filter Not Submitted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "sendTo": "={{$json.email}}",
        "subject": "Reminder: Please Submit Your Timesheet",
        "emailType": "text",
        "message": "=Dear {{$json.name}},\n\nThis is a friendly reminder that your timesheet for this week has not been submitted yet.\n\nPlease complete and submit your timesheet before end of day today (Friday).\n\nIf you have any questions about timesheet submission, please contact HR.\n\nThank you,\nHR Automation",
        "options": {}
