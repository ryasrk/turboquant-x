      "position": [470, 600],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const records = $input.all().map(i => i.json);\nconst lastWeek = new Date();\nlastWeek.setDate(lastWeek.getDate() - 3);\nconst weekEnding = lastWeek.toISOString().slice(0, 10);\nconst stillMissing = records.filter(r => {\n  return r.weekEnding === weekEnding && (!r.submitted || r.submitted === 'no');\n});\nreturn stillMissing.map(r => ({ json: r }));"
      },
      "name": "Filter Still Missing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [690, 600]
    },
    {
      "parameters": {
        "sendTo": "={{$json.managerEmail}}",
        "subject": "=ESCALATION: Missing Timesheet - {{$json.name}}",
        "emailType": "text",
        "message": "=Dear {{$json.managerName}},\n\nThis is an escalation notice. The following employee has not submitted their timesheet for last week:\n\nEmployee: {{$json.name}}\nDepartment: {{$json.department}}\nWeek Ending: {{$json.weekEnding}}\n\nA reminder was sent on Friday. Please follow up with the employee.\n\nThank you,\nHR Automation",
        "options": {}
      },
      "name": "Escalate to Manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [910, 600],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "content": "## Timesheet Submission Reminder\n\n**Flow 1 - Friday Reminder:**\n- Trigger: Every Friday at 4 PM\n- Check who hasn't submitted timesheet\n- Send email + Telegram reminder\n\n**Flow 2 - Monday Escalation:**\n- Trigger: Every Monday at 10 AM\n- Check if timesheets from last week are still missing\n- Escalate to manager via email\n\n**Setup:**\n- 'Timesheets' sheet: name, email, telegramChatId, managerEmail, managerName, department, weekEnding, submitted\n- Gmail + Telegram bot credentials",
        "width": 420,
        "height": 300
      },
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, -60]
    }
