        },
        "options": {}
      },
      "id": "sheets-results",
      "name": "Sheets Results",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "content": "## PDF Text Search and Extract\n\nReceive search terms via webhook → read PDF inventory from Sheets →\nExtract text from each PDF via OCR → search for matches with context →\nResults saved to Sheets.\n\n**Setup:**\n1. Create PDF inventory sheet (columns: pdfName, pdfUrl)\n2. Configure OCR API credentials\n3. Set results Google Sheet\n4. POST { searchTerms: ['term1', 'term2'] } to webhook"
      },
      "id": "sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 80]
    }
  ],
