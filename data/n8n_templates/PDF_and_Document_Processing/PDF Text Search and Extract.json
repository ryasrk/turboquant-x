      "id": "sheets-inventory",
      "name": "Read Sheets PDF Inventory",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.pdfUrl }}",
        "method": "POST",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.pdfUrl }}"
            },
            {
              "name": "language",
              "value": "eng"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "extract-text",
      "name": "HTTP Extract Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst searchTerms = $('Webhook Search Terms').item.json.body.searchTerms || [];\nconst results = [];\nfor (const item of items) {\n  const text = item.json.ParsedResults?.[0]?.ParsedText || item.json.data || '';\n  const pdfName = item.json.pdfName || 'Unknown';\n  for (const term of searchTerms) {\n    const regex = new RegExp(`(.{0,50}${term.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}.{0,50})`, 'gi');\n    const matches = text.match(regex) || [];\n    if (matches.length > 0) {\n      results.push({\n        json: {\n          pdfName,\n          searchTerm: term,\n          matchCount: matches.length,\n          contexts: matches.slice(0, 5),\n          foundAt: new Date().toISOString()\n        }\n      });\n    }\n  }\n}\nif (results.length === 0) {\n  results.push({ json: { message: 'No matches found', searchTerms } });\n}\nreturn results;"
      },
      "id": "search-matches",
      "name": "Code Search Matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
