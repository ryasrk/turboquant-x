    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "" },
        "sheetName": { "__rl": true, "mode": "byName", "value": "Post Log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.toISO() }}",
            "Platform": "={{ $json.Platform }}",
            "Content Preview": "={{ $json.Content?.substring(0, 100) }}",
            "Post URL": "={{ $json.data?.id || 'N/A' }}",
            "Status": "Posted"
          }
        },
        "options": {}
      },
      "name": "Log Post URLs to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1350, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "name": "Weekly Recap Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 700]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "" },
        "sheetName": { "__rl": true, "mode": "byName", "value": "Post Log" },
        "options": {}
      },
      "name": "Read Post Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [470, 700],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.all();\nconst lastWeek = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst weeklyPosts = posts.filter(p => new Date(p.json.Date) >= lastWeek);\n\nconst byPlatform = {};\nfor (const p of weeklyPosts) {\n  const plat = p.json.Platform || 'Unknown';\n  byPlatform[plat] = (byPlatform[plat] || 0) + 1;\n}\n\nconst recap = Object.entries(byPlatform)\n  .map(([platform, count]) => `${platform}: ${count} posts`)\n  .join('\\n');\n\nreturn [{ json: {\n  totalPosts: weeklyPosts.length,\n  recap,\n  period: `${lastWeek.toISOString().split('T')[0]} to ${new Date().toISOString().split('T')[0]}`\n}}];"
      },
      "name": "Generate Weekly Recap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 700]
    },
    {
      "parameters": {
        "sendTo": "",
        "subject": "📊 Weekly Social Media Recap - {{ $json.totalPosts }} Posts",
        "emailType": "html",
        "message": "<h2>Weekly Social Media Recap</h2><p><strong>Period:</strong> {{ $json.period }}</p><p><strong>Total Posts:</strong> {{ $json.totalPosts }}</p><h3>Breakdown by Platform</h3><pre>{{ $json.recap }}</pre>",
        "options": {
          "senderName": "Social Media Bot"
        }
      },
      "name": "Email Weekly Recap",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [910, 700],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "content": "## Social Media Post Scheduler Multi-Platform\n\n**How to use:**\n1. Create Google Sheets with 'Content Calendar' tab:\n   - Columns: Scheduled Date, Platform, Content, ImageURL, Link, FacebookPageId, InstagramAccountId, Status\n2. Create 'Post Log' tab for tracking\n3. Configure OAuth2 credentials for each platform\n4. Set your email for weekly recap notifications\n\n**Schedule:** Daily at 8am checks for today's posts. Weekly recap every Monday at 9am.\n\n**Platforms supported:** Twitter, Instagram, Facebook\n\n**Content Calendar tips:**\n- Platform column: 'Twitter', 'Instagram', or 'Facebook'\n- Set Status to 'Posted' after publishing to avoid duplicates\n- Include ImageURL for Instagram posts\n- Include Link for Facebook posts",
        "width": 420,
        "height": 340
      },
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [250, -80]
    }
  ],
