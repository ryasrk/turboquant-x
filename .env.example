# ── TurboQuant-X Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────
TURBOQUANT_HOST=0.0.0.0
TURBOQUANT_PORT=8000

# ── Reverse Proxy / CORS ────────────────────────────────────────────
# Extra allowed origins (comma-separated). Added on top of config/default.yaml.
# TURBOQUANT_CORS_ORIGINS=https://my-domain.com,https://other.example.com

# ── Security ─────────────────────────────────────────────────────────
# JWT signing secret — MUST be changed for production
# TQ_JWT_SECRET=change-me-to-a-random-64-char-string

# ── Ngrok Tunnel ─────────────────────────────────────────────────────
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
NGROK_DOMAIN=your-domain.ngrok-free.dev
